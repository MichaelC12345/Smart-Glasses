// ======================
// ESP32 Arduino (FULL)
// OLED shows:
// City: Pomona
// T 3:26:35 PM Sun
// 72F H80 L45 (Clouds)
// ======================
#include <Arduino.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

#include <BLEDevice.h>
#include <BLEUtils.h>
#include <BLEServer.h>

// Full 128-bit UUIDs (best iOS compatibility)
#define SERVICE_UUID        "00001234-0000-1000-8000-00805f9b34fb"
#define CHARACTERISTIC_UUID "00005678-0000-1000-8000-00805f9b34fb"

// OLED (128x32)
#define SCREEN_WIDTH  128
#define SCREEN_HEIGHT 32
#define OLED_RESET    -1

Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

// Received fields
String receivedTime = "--:--:--";
String receivedDay  = "---";

String receivedCity = "----";
String receivedTemp = "--";
String receivedHi   = "--";
String receivedLo   = "--";
String receivedCond = "--";

// Split helper
String getField(const String &s, int index, char sep) {
  int found = 0;
  int start = 0;
  for (int i = 0; i <= s.length(); i++) {
    if (i == s.length() || s.charAt(i) == sep) {
      if (found == index) return s.substring(start, i);
      found++;
      start = i + 1;
    }
  }
  return "";
}

// Clip long lines to avoid wrapping off screen
String clipTo(const String &s, int maxChars) {
  if ((int)s.length() <= maxChars) return s;
  return s.substring(0, maxChars - 1) + ".";
}

// Sunday -> Sun
String shortDay(const String &d) {
  String x = d;
  x.trim();
  if (x.length() < 3) return x;
  return x.substring(0, 3);
}

void updateOLED() {
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);

  // Line 1
  display.setCursor(0, 0);
  String line1 = "City: " + receivedCity;
  display.print(clipTo(line1, 21));

  // Line 2
  display.setCursor(0, 12);
  String line2 = "T " + receivedTime + " " + shortDay(receivedDay);
  display.print(clipTo(line2, 21));

  // Line 3
  display.setCursor(0, 22);
  String line3 = receivedTemp + "F H" + receivedHi + " L" + receivedLo + " (" + receivedCond + ")";
  display.print(clipTo(line3, 21));

  display.display();
}

class MyCallbacks : public BLECharacteristicCallbacks {
  void onWrite(BLECharacteristic *pCharacteristic) override {
    String msg = pCharacteristic->getValue();
    msg.trim();
    if (msg.length() == 0) return;

    Serial.print("Message received: ");
    Serial.println(msg);

    if (msg.startsWith("TIME:")) {
      // TIME:3:26:35 PM|Sunday
      String payload = msg.substring(5);
      receivedTime = getField(payload, 0, '|');
      receivedDay  = getField(payload, 1, '|');
      if (receivedDay.length() == 0) receivedDay = "---";
    }
    else if (msg.startsWith("WEATHER:")) {
      // WEATHER:City|Temp|Hxx|Lxx|Condition
      String payload = msg.substring(8);

      receivedCity = getField(payload, 0, '|');
      receivedTemp = getField(payload, 1, '|');

      String hiField = getField(payload, 2, '|');
      String loField = getField(payload, 3, '|');
      receivedCond   = getField(payload, 4, '|');

      if (hiField.startsWith("H")) receivedHi = hiField.substring(1);
      else receivedHi = hiField;

      if (loField.startsWith("L")) receivedLo = loField.substring(1);
      else receivedLo = loField;
    }

    updateOLED();
  }
};

void setup() {
  Serial.begin(115200);
  delay(200);

  Wire.begin(21, 22);

  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println("OLED NOT FOUND (try 0x3D)!");
    while (true) delay(100);
  }

  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(0, 0);
  display.println("Waiting for BLE...");
  display.display();

  BLEDevice::init("ARIS-ESP32");

  BLEServer *pServer = BLEDevice::createServer();
  BLEService *pService = pServer->createService(SERVICE_UUID);

  BLECharacteristic *pCharacteristic = pService->createCharacteristic(
    CHARACTERISTIC_UUID,
    BLECharacteristic::PROPERTY_WRITE | BLECharacteristic::PROPERTY_WRITE_NR
  );

  pCharacteristic->setCallbacks(new MyCallbacks());
  pService->start();

  BLEAdvertising *pAdvertising = BLEDevice::getAdvertising();
  pAdvertising->addServiceUUID(SERVICE_UUID);
  pAdvertising->setScanResponse(true);
  BLEDevice::startAdvertising();

  updateOLED();
}

void loop() {
  delay(10);
}
